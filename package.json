{
  "name": "libmojangles",
  "type": "module",
  "version": "1.4.8",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Pixel perfect Minecraft text rendering on the web, based on resourcepacks.",
  "homepage": "https://forgejo.perny.dev/perny/libmojangles",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://forgejo.perny.dev/perny/libmojangles.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "dev": "cd devserver && bun run dev",
    "test": "bun test",
    "test:visual": "bun test tests/visual/visual.test.ts",
    "generate-headers": "bun run scripts/generate-headers.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "vite": "^8.0.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
